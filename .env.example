# ============ 邮件接入（IMAP） ============
# IMAP 服务器地址。163 邮箱: imap.163.com；QQ 邮箱: imap.qq.com
IMAP_HOST=imap.qq.com
# IMAP 端口。SSL 加密: 993；非加密: 143
IMAP_PORT=993
# 邮箱账号
IMAP_USER=2649279391@qq.com
# 邮箱授权码（163/QQ 需在网页端开启 IMAP 后生成授权码，非登录密码）
IMAP_PASS=bhtrkeoasazpecha
# 是否使用 TLS/SSL 加密连接（993 端口通常为 true）
IMAP_TLS=true

# ============ 邮件存储（SQLite） ============
# 邮件入库去重数据库路径（相对项目根目录）
MAIL_DB_PATH=data/mail.db

# ============ 公司尽调 CLI（企查查官方 qcc-agent-cli） ============
# 安装：npm install -g qcc-agent-cli
# 绑定 API Key（agent.qcc.com 注册获取）：qcc init --authorization "Bearer 你的APIKey"
# 命令模板中 {name} 会被替换为待查询的公司名；输出为原始 JSON。
# 未配置时降级为 Bing 线索发现（只判定国内/海外，不做股权风险深挖）。
# 本地调试可先用 mock 验证链路: node scripts/mock-company-cli.js {name}
# 工商登记（必配）
COMPANY_CLI_CMD=qcc company get_company_registration_info {name}
# 股东结构（可选，深挖股权）
# COMPANY_CLI_SHAREHOLDER_CMD=qcc company get_shareholder_info {name}
# 司法/经营风险（可选，深挖风险）
# COMPANY_CLI_RISK_CMD=qcc risk get_judicial_documents {name}
# COMPANY_CLI_TIMEOUT=30000
# CLI 命令执行失败（非零退出/超时）后的额外重试次数（总尝试 = 1 + 该值），0 = 不重试
COMPANY_CLI_RETRIES=1
# 每次重试前的等待时间（毫秒）
COMPANY_CLI_RETRY_DELAY=1000

# ============ 邮件发送（SMTP） ============
# 163/QQ 的 SMTP 账号与授权码和 IMAP 相同，默认复用 IMAP_USER/IMAP_PASS，无需重复配置。
# 如需独立覆盖：取消注释下面三行
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your_account@163.com
# SMTP_PASS=your_authorization_code
SMTP_TLS=true
# 回复收件人覆盖（默认回复原邮件发件人；CLI 手工指定正文时可用它指定回信目标）
# REPLY_TO=

# ============ 公司名查询 CLI（tyc-cli / qcc-agent-cli，可选） ============
# 命令模板中的 {name} 会被替换为公司名；输出应为 JSON 或可读文本
# COMPANY_CLI_CMD=tyc-cli --company {name}
# COMPANY_CLI_TIMEOUT=30000

# ============ 大模型（DeepSeek） ============
# 在 platform.deepseek.com → API Keys 创建，形如 sk-xxxx
DEEPSEEK_API_KEY=sk-your_api_key
# 模型：deepseek-chat（V3，抽取/汇总用）或 deepseek-reasoner（R1，思考型）
DEEPSEEK_MODEL=deepseek-chat
# 官方 API 地址，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 名单筛查（Dow Jones RiskCenter，制裁/PEP/高风险，可选） ============
# 付费订阅服务，需 SSO 登录后搜索；未配置时名单查询返回 requires_login（不假装可查）
# DOWJONES_USER=your_dowjones_username
# DOWJONES_PASS=your_dowjones_password

# ============ 网页查询重试 ============
# 所有网页信息查询（运单/集装箱/提单/公司/个人/名单主通道，及 Bing 搜索）失败后的
# 额外重试次数（总尝试 = 1 + 该值）。仅对「站点不可达/导航超时/网络异常」类请求失败重试，
# 业务性无结果（如官网查无此单、名单无命中）不会重试。0 = 不重试
WEB_QUERY_RETRIES=1
# 每次重试前的等待时间（毫秒）
WEB_QUERY_RETRY_DELAY=3000
