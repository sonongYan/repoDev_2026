{
  "carrier": "cosco",
  "version": 1,
  "queryType": "container",
  "queryKey": "number",
  "description": "COSCO eBusiness 箱号查询（iView 下拉切换查询类型 + 搜索按钮）",
  "entry": {
    "url": "https://elines.coscoshipping.com/ebusiness/",
    "waitUntil": "domcontentloaded",
    "timeoutMs": 60000,
    "settleMs": 4000
  },
  "valueFormats": {
    "number": "upper"
  },
  "popups": [
    {
      "css": [
        "button:has-text('确定')",
        "button:has-text('确认')",
        "button:has-text('同意')",
        "button:has-text('OK')"
      ],
      "waitAfter": 1500
    },
    {
      "css": [
        "button:has-text('允许全部')",
        "button:has-text('拒绝全部')",
        "button:has-text('接受全部')",
        "button:has-text('同意全部')",
        "button:has-text('接受')",
        "button:has-text('同意')",
        "button:has-text('Accept')"
      ],
      "waitAfter": 1000
    }
  ],
  "steps": [
    { "action": "wait", "ms": 2000 },
    {
      "action": "click",
      "optional": true,
      "locator": { "css": ["li.search_t_act"] },
      "waitAfter": 1500
    },
    {
      "action": "click",
      "optional": true,
      "locator": {
        "css": [".ivu-select .ivu-select-selection", ".ivu-select"]
      },
      "waitAfter": 1000
    },
    {
      "action": "click",
      "locator": {
        "css": ["li.ivu-select-item:has-text('箱号')", "li.ivu-select-item >> text=箱号"]
      },
      "waitAfter": 1000
    },
    {
      "action": "fill",
      "valueFrom": "number",
      "locator": {
        "placeholder": "箱号",
        "css": ["input.ivu-input[placeholder*='箱号']", "input.ivu-input"]
      }
    },
    {
      "action": "click",
      "locator": {
        "role": { "type": "button", "name": "搜索" },
        "css": ["button:has-text('搜索')"]
      }
    }
  ],
  "result": {
    "mode": "dom",
    "domFallback": {
      "match": "some",
      "successKeywords": ["动态节点", "预计到港", "箱型尺寸"],
      "noDataKeywords": ["无法找到", "未找到", "无数据", "无结果", "查无"]
    },
    "wait": {
      "timeoutMs": 45000,
      "intervalMs": 1500
    },
    "noDataGraceMs": 10000
  },
  "meta": {
    "createdAt": "2026-11-11",
    "lastVerified": null,
    "notes": "表单为 iView 组件：先点 .ivu-select 展开，再点 li.ivu-select-item 切换查询类型；箱号输入框为 input.ivu-input"
  }
}
